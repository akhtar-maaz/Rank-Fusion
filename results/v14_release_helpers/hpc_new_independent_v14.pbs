#!/bin/bash -l
#PBS -N rankfusion-v14-independent
#PBS -P col764.course
#PBS -q standard
#PBS -l select=1:ncpus=4:mem=24gb:centos=genoa
#PBS -l walltime=01:05:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
mkdir -p runs/refit_v14/independent
exec > >(tee runs/new_independent_v14.log) 2>&1
.venv/bin/python scripts/train_model.py --train data/train --dev data/dev --use-dev --config configs/v14_new_members.json --out runs/refit_v14/independent/model.txt --fit-record runs/refit_v14/independent/fit.json
