#!/bin/bash -l
#PBS -N rankfusion-neural-v7
#PBS -P col764.course
#PBS -q standard
#PBS -l select=1:ncpus=4:mem=8gb:centos=genoa
#PBS -l walltime=00:50:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
mkdir -p runs/neural_v7
exec > >(tee runs/neural_v7/job.log) 2>&1
.venv/bin/python scripts/cv_pairwise_ensemble_v7.py --mode cv
.venv/bin/python scripts/cv_pairwise_ensemble_v7.py --mode select
