#!/bin/bash -l
#PBS -N rankfusion-pick-p-v6
#PBS -P col764.course
#PBS -q standard
#PBS -l select=1:ncpus=1:mem=1gb:centos=genoa
#PBS -l walltime=00:05:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
exec > >(tee runs/neural_v6/selection.log) 2>&1
.venv/bin/python scripts/select_pairwise_v6.py
