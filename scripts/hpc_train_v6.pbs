#!/bin/bash -l
#PBS -N rankfusion-final-v6
#PBS -P col764.course
#PBS -q standard
#PBS -l select=1:ncpus=4:mem=12gb:centos=genoa
#PBS -l walltime=01:05:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
exec > >(tee runs/final_train_v6.log) 2>&1
cp results/lambdamart_cv_v6.json results/lambdamart_cv.json
rank_promoted="$(.venv/bin/python -c 'import json;print(int(json.load(open("results/lambdamart_cv_v6.json"))["promoted"]))')"
if [[ "$rank_promoted" == 1 ]]; then
    .venv/bin/python scripts/train_model.py --train data/train --config results/lambdamart_cv.json --out submission/model.txt
else
    cp runs/baseline_v5/model.txt submission/model.txt
fi
.venv/bin/python scripts/fit_pairwise_v6.py
# Both choices are frozen from TRAIN before this single final DEV evaluation.
.venv/bin/python scripts/evaluate_models.py --features data/dev/vali.txt --out results/dev_metrics.json
