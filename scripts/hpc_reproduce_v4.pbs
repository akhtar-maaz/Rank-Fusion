#!/bin/bash -l
#PBS -N rankfusion-reproduce-v4
#PBS -P col764.course
#PBS -q standard
#PBS -l select=1:ncpus=4:mem=8gb:centos=genoa
#PBS -l walltime=00:30:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
exec > >(tee runs/reproduce_v4.log) 2>&1
.venv/bin/python - <<'PY'
import json
from pathlib import Path
assert json.loads(Path('results/lambdamart_cv_v4.json').read_text())['promoted'], 'retain v3'
PY
.venv/bin/python scripts/train_model.py --train data/train --config results/lambdamart_cv_v4.json --out runs/reproduced_model_v4.txt
