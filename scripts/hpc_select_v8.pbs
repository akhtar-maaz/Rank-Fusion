#!/bin/bash -l
#PBS -N rankfusion-select-v8
#PBS -P col764.course
#PBS -q standard
#PBS -l select=1:ncpus=4:mem=12gb:centos=genoa
#PBS -l walltime=00:50:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
exec > >(tee runs/cv_v8/selection.log) 2>&1
.venv/bin/python scripts/select_eighth_round.py
