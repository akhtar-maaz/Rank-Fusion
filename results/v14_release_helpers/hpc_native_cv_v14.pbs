#!/bin/bash -l
#PBS -N rankfusion-v14-native
#PBS -P col764.course
#PBS -q standard
#PBS -l select=1:ncpus=4:mem=16gb:centos=genoa
#PBS -l walltime=00:25:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
exec > >(tee runs/native_cv_v14.log) 2>&1
.venv/bin/python runs/verify_v14_cv.py
