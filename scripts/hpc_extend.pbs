#!/bin/bash -l
#PBS -N rankfusion-extend
#PBS -P col764.course
#PBS -q standard
#PBS -l select=1:ncpus=4:mem=8gb:centos=genoa
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
.venv/bin/python scripts/cv_lambdamart.py --train data/train \
    --config runs/lambdamart_cv_initial.json --trees 800 1200 --out runs/cv/extension.json
