#!/bin/bash -l
#PBS -N rankfusion-pair-pri-v12
#PBS -P col764.course
#PBS -q standard
#PBS -l select=1:ncpus=4:mem=8gb:centos=genoa
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
mkdir -p runs/refit_v12/pairwise_primary
exec > >(tee runs/pairwise_primary_v12.log) 2>&1
.venv/bin/python runs/record_v12_runtime.py runs/refit_v12/pairwise_primary/runtime.json
.venv/bin/python scripts/cv_pairwise_ensemble_v12.py --mode fit --fresh \
    --cache-dir runs/refit_v12/pairwise_primary/cache --out runs/refit_v12/pairwise_primary/pairwise_model.pt \
    --history-out runs/refit_v12/pairwise_primary/fit.json
