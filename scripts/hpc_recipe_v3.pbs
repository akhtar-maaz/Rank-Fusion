#!/bin/bash -l
#PBS -N rankfusion-recipe-v3
#PBS -P col764.course
#PBS -q standard
#PBS -l select=1:ncpus=4:mem=8gb:centos=genoa
#PBS -l walltime=00:30:00
#PBS -J 0-2
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
mkdir -p runs/recipe_v3
exec > >(tee "runs/recipe_v3/job_${PBS_ARRAY_INDEX}.log") 2>&1
.venv/bin/python scripts/check_recipe_policy.py --domain "$PBS_ARRAY_INDEX"
