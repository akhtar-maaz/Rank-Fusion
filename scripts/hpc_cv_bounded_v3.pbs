#!/bin/bash -l
#PBS -N rankfusion-cv-v3-bounded
#PBS -P col764.course
#PBS -q standard
#PBS -l select=1:ncpus=4:mem=8gb:centos=genoa
#PBS -l walltime=01:00:00
#PBS -J 2-3
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
mkdir -p runs/cv_v3_bounded
exec > >(tee "runs/cv_v3_bounded/job_${PBS_ARRAY_INDEX}.log") 2>&1
.venv/bin/python scripts/cv_robust_lambdamart.py --candidate "$PBS_ARRAY_INDEX" \
    --tree-cap 800 --resume --out-dir runs/cv_v3_bounded
