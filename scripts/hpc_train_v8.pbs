#!/bin/bash -l
#PBS -N rankfusion-final-v8
#PBS -P col764.course
#PBS -q standard
#PBS -l select=1:ncpus=4:mem=12gb:centos=genoa
#PBS -l walltime=01:30:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
exec > >(tee runs/final_train_v8.log) 2>&1
cp results/lambdamart_cv_v8.json results/lambdamart_cv.json
rank_promoted="$(.venv/bin/python -c 'import json;print(int(json.load(open("results/lambdamart_cv_v8.json"))["promoted"]))')"
if [[ "$rank_promoted" == 1 ]]; then
    .venv/bin/python scripts/train_model.py --train data/train --config results/lambdamart_cv.json --out submission/model.txt
else
    cp runs/baseline_v7_1/model.txt submission/model.txt
fi
.venv/bin/python scripts/cv_pairwise_ensemble_v8.py --mode fit --fresh --cache-dir runs/neural_v8/final_cache
# This is the only released DEV evaluation, after both TRAIN choices are fixed.
.venv/bin/python scripts/evaluate_models.py --features data/dev/vali.txt --out results/dev_metrics.json
