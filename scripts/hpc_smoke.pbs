#!/bin/bash -l
#PBS -N rankfusion-smoke
#PBS -P col764.course
#PBS -q standard
#PBS -l select=1:ncpus=4:mem=8gb:centos=genoa
#PBS -l walltime=00:15:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
export RANK_FUSION_PYTHON="$PWD/.venv/bin/python"
"$RANK_FUSION_PYTHON" --version
bash scripts/smoke_test.sh
